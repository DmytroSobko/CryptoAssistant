# The Go API listens on this address when running locally.
CRYPTO_ASSISTANT_API_ADDR=:8080

# Relative paths are resolved from backend/ when using `make dev`.
CRYPTO_ASSISTANT_DB_PATH=data/cryptoassistant.db
CRYPTO_ASSISTANT_MIGRATIONS_DIR=migrations

# Dashboard display prices are refreshed while the Dashboard is open.
CRYPTO_ASSISTANT_PRICE_REFRESH_INTERVAL=30s

