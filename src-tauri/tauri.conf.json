{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crypto Strategy Assistant",
  "version": "0.1.0",
  "identifier": "com.cryptoassistant.local",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Crypto Strategy Assistant",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

